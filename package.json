{
	"name": "my-9y-project",
	"license": "ISC",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"admin:dev": "node scripts/run-app-script.mjs admin dev",
		"admin:build": "node scripts/run-app-script.mjs admin build",
		"admin:preview": "node scripts/run-app-script.mjs admin preview",
		"ipad:dev": "node scripts/run-app-script.mjs ipad dev",
		"ipad:build": "node scripts/run-app-script.mjs ipad build",
		"clean:all-dists": "pnpm -r exec rm -rf dist",
		"clean:all-node_modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
		"lint": "biome check",
		"lint:fix": "biome check --write --unsafe",
		"prepare": "husky",
		"lint:lint-staged": "lint-staged",
		"commit": "git-cz",
		"ncu": "ncu",
		"ncu:update": "ncu -u"
	},
	"lint-staged": {
		"*.{js,ts,tsx,cjs,mjs}": [
			"biome check --write --unsafe"
		],
		"*.{json,jsonc}": [
			"biome check --write --unsafe"
		],
		"*.{css,scss}": [
			"biome check --write --unsafe"
		]
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react-swc": "catalog:",
		"commitizen": "^4.3.2",
		"cz-git": "^1.13.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"npm-check-updates": "^23.0.2",
		"rollup-plugin-visualizer": "^7.1.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
